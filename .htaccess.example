# Example only — never commit real secrets.
# Prefer putting secrets in `.env` (gitignored) instead of SetEnv lines.
# SetEnv STRIPE_SECRET_KEY sk_test_REPLACE_ME
# SetEnv STRIPE_SECRET_SIGN whsec_REPLACE_ME
# SetEnv STRIPE_PUBLISHABLE_KEY pk_test_REPLACE_ME

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^robots\.txt$ /robots.php [L,QSA]
RewriteRule ^sitemap\.xml$ /sitemap.php [L,QSA]
RewriteRule ^api/?$ /api-lite/public/index.php [L,QSA]
RewriteRule ^api/(.*)$ /api-lite/public/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]
</IfModule>
# Disable directory listing
Options All -Indexes

# Remove header with PHP version
Header always unset X-Powered-By
Header unset X-Powered-By
# END Security Block
